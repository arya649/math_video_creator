  "lines": [
    {
      "en": "Start at minus two, and {hop}jump five to the right.",
      "hi": "माइनस दो से शुरू करें, और {hop}पाँच कदम दाईं ओर कूदें।"
    },
    {
      "en": "Four jumps of three land on {land}twelve.",
      "hi": "तीन-तीन की चार छलाँगें {land}बारह पर पहुँचती हैं।"
    },
    {
      "en": "Now zoom in between zero and one.",
      "hi": "अब शून्य और एक के बीच ज़ूम करें।"
    },
    {
      "en": "Three rows of four: twelve apples.",
      "hi": "चार-चार की तीन पंक्तियाँ: बारह सेब।"
    },
    {
      "en": "Three quarters is the same as {split}six eighths.",
      "hi": "तीन चौथाई {split}छह आठवें के बराबर है।"
    },
    {
      "en": "Flip a coin fifty times.",
      "hi": "एक सिक्का पचास बार उछालें।"
    },
    {
      "en": "Two dice: six ways out of thirty-six to make seven.",
      "hi": "दो पासे: छत्तीस में से छह तरीके सात बनाने के।"
    }
  ],
